# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://metis:metis@localhost:15432/metis
REDIS_URL=redis://localhost:6379/0

# ─── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX
RAZORPAY_WEBHOOK_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX

# ─── Groq (AI Agent) ─────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Available: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile

# ─── ML Models ────────────────────────────────────────────────────────────────
# Paths relative to backend/ — leave empty to use rule-based stubs
ML_MODELS_DIR=models
PROPENSITY_MODEL_PATH=
INTERVENTION_MODEL_PATH=
UPLIFT_MODEL_PATH=
FATIGUE_MODEL_PATH=

# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-in-production-use-a-32-byte-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ─── MLflow ───────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5050

# ─── Frontend ─────────────────────────────────────────────────────────────────
# FastAPI origin used by Next.js on the server and by its same-origin API proxy.
METIS_API_URL=http://localhost:8000
